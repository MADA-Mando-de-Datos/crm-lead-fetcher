<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_view_lead_leads" model="ir.actions.act_window">
        <field name="name">Leads de la solicitud</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('lead_request_id', '=', active_id), ('type', '=', 'lead')]</field>
        <field name="context">{'default_type': 'lead', 'default_lead_request_id': active_id}</field>
    </record>

    <record id="action_view_lead_opportunities" model="ir.actions.act_window">
        <field name="name">Oportunidades de la solicitud</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('lead_request_id', '=', active_id), ('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity', 'default_lead_request_id': active_id}</field>
    </record>

    <record id="action_server_enrich_leads_batch" model="ir.actions.server">
        <field name="name">Enriquecer Emails y Webs en Lote</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_enrich_email_batch()
        </field>
    </record>
</odoo>
