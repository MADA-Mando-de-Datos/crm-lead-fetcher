<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_request_view_form" model="ir.ui.view">
        <field name="name">crm.lead.request.form</field>
        <field name="model">crm.lead.request</field>
        <field name="arch" type="xml">
            <form string="Generación de Leads">
                <header>
                    <button name="action_submit" string="Generar Leads" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_test_connection" string="Probar Conexión" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_duplicate_request" string="Nueva Búsqueda" type="object"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="crm_lead_fetcher.action_view_lead_leads" type="action"
                                class="oe_stat_button" icon="fa-star"
                                invisible="lead_type != 'lead' or lead_count == 0">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                        <button name="crm_lead_fetcher.action_view_lead_opportunities" type="action"
                                class="oe_stat_button" icon="fa-star"
                                invisible="lead_type != 'opportunity' or lead_count == 0">
                            <field name="lead_count" widget="statinfo" string="Oportunidades"/>
                        </button>
                    </div>

                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>Error:</strong> <field name="error_msg" readonly="1" class="d-inline"/>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ej: Restaurantes San Luis Potosí" readonly="state != 'draft'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuración del Lead">
                            <field name="source_key" readonly="state != 'draft'"/>
                            <field name="lead_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="lead_number" readonly="state != 'draft'"/>
                        </group>
                        <group string="Asignación Comercial">
                            <field name="team_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Pestaña Búsqueda DENUE -->
                        <page string="Criterios de Búsqueda" name="denue_criteria" invisible="source_key != 'denue'">
                            <group>
                                <group string="Ubicación y Tipo">
                                    <field name="search_type" readonly="state != 'draft'"/>
                                    <field name="entidad_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"
                                           domain="[('active', '=', True)]"
                                           required="source_key == 'denue'"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="Parámetros">
                                    <field name="actividad"
                                           invisible="search_type != 'by_activity_state'"
                                           placeholder="Ej: restaurante, ferretería, dentista"
                                           readonly="state != 'draft'"/>
                                    <field name="sector_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"
                                           invisible="search_type != 'by_state'"
                                           required="source_key == 'denue' and search_type == 'by_state'"
                                           readonly="state != 'draft'"/>
                                    <field name="nombre_busqueda"
                                           invisible="search_type != 'by_name_state'"
                                           placeholder="Ej: Oxxo, Walmart, Farmacias Guadalajara"
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group string="Filtro por Tamaño de Negocio">
                                <group>
                                    <field name="estrato_min" readonly="state != 'draft'"/>
                                    <field name="estrato_max" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <!-- Pestaña Búsqueda Yelp -->
                        <page string="Criterios de Búsqueda" name="yelp_criteria" invisible="source_key != 'yelp'">
                            <group>
                                <group>
                                    <field name="yelp_term" placeholder="Ej: restaurantes, abogados, spas" readonly="state != 'draft'"/>
                                    <field name="yelp_location" required="source_key == 'yelp'" placeholder="Ej: San Luis Potosí, Querétaro" readonly="state != 'draft'"/>
                                    <field name="yelp_categories" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <!-- Pestaña Búsqueda Google Places -->
                        <page string="Criterios de Búsqueda" name="google_criteria" invisible="source_key != 'google'">
                            <group>
                                <group>
                                    <field name="google_query" placeholder="Ej: contadores públicos, clínicas dentales" readonly="state != 'draft'"/>
                                    <field name="google_location" required="source_key == 'google'" placeholder="Ej: San Luis Potosí, SLP" readonly="state != 'draft'"/>
                                    <field name="google_place_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <!-- Pestaña Leads Generados -->
                        <page string="Leads Generados" name="generated_leads" invisible="state != 'done'">
                            <div class="mb-2">
                                <button name="action_export_csv" type="object" class="btn btn-sm btn-outline-success" icon="fa-download" string="Exportar a CSV"/>
                            </div>
                            <field name="lead_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="contact_name" optional="show"/>
                                    <field name="phone"/>
                                    <field name="email_from"/>
                                    <field name="city"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_lead_request_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.request.list</field>
        <field name="model">crm.lead.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Minado de Leads">
                <field name="name"/>
                <field name="source_key" widget="badge" decoration-info="source_key == 'denue'" decoration-warning="source_key == 'yelp'" decoration-success="source_key == 'google'"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-warning="state == 'draft'"/>
                <field name="lead_count" string="Leads generados"/>
                <field name="lead_type" widget="badge" decoration-info="lead_type == 'lead'" decoration-primary="lead_type == 'opportunity'"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="crm_lead_request_action" model="ir.actions.act_window">
        <field name="name">Minado de Leads</field>
        <field name="res_model">crm.lead.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="crm_menu_lead_generation"
        name="Minado de Leads"
        parent="crm.crm_menu_config"
        sequence="21"/>
    <menuitem
        id="crm_lead_request_menu_action"
        action="crm_lead_request_action"
        parent="crm_menu_lead_generation"
        sequence="0"/>
</odoo>
