<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.lead.fetcher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='generate_lead_setting_container']" position="before">
                <block title="Minado de Leads - DENUE (INEGI)" name="denue_lead_setting_container" groups="base.group_system">
                    <setting id="crm_lead_fetcher_denue_settings"
                        string="Directorio DENUE"
                        help="Directorio oficial de unidades económicas del INEGI (México).">
                        <label for="denue_token" string="Token de la API" class="col-lg-3 o_light_label fw-bold"/>
                        <div class="d-flex gap-2">
                            <field name="denue_token" widget="password" placeholder="Pegue su token de INEGI..." class="font-monospace flex-fill"/>
                            <button type="object" name="action_test_denue_connection" class="btn-outline-primary btn-sm"><i class="fa fa-plug"/> Probar conexión</button>
                            <button type="object" name="action_open_denue_token_page" class="btn-outline-secondary btn-sm"><i class="fa fa-external-link"/> Obtener token</button>
                        </div>
                    </setting>
                </block>

                <block title="Minado de Leads - Yelp" name="yelp_lead_setting_container" groups="base.group_system">
                    <setting id="crm_lead_fetcher_yelp_settings"
                        string="Directorio Yelp"
                        help="Búsqueda comercial en Yelp Fusion API con teléfonos y sitios web.">
                        <label for="yelp_api_key" string="API Key" class="col-lg-3 o_light_label fw-bold"/>
                        <div class="d-flex gap-2">
                            <field name="yelp_api_key" widget="password" placeholder="Pegue su API Key de Yelp..." class="font-monospace flex-fill"/>
                            <button type="object" name="action_test_yelp_connection" class="btn-outline-primary btn-sm"><i class="fa fa-plug"/> Probar conexión</button>
                            <button type="object" name="action_open_yelp_developer_page" class="btn-outline-secondary btn-sm"><i class="fa fa-external-link"/> Obtener clave</button>
                        </div>
                    </setting>
                </block>

                <block title="Minado de Leads - Google Places" name="google_lead_setting_container" groups="base.group_system">
                    <setting id="crm_lead_fetcher_google_settings"
                        string="Directorio Google Places"
                        help="Búsqueda global en Google Maps con teléfonos y sitios web.">
                        <label for="google_places_api_key" string="API Key" class="col-lg-3 o_light_label fw-bold"/>
                        <div class="d-flex gap-2">
                            <field name="google_places_api_key" widget="password" placeholder="Pegue su API Key de Google Places..." class="font-monospace flex-fill"/>
                            <button type="object" name="action_test_google_connection" class="btn-outline-primary btn-sm"><i class="fa fa-plug"/> Probar conexión</button>
                            <button type="object" name="action_open_google_developer_page" class="btn-outline-secondary btn-sm"><i class="fa fa-external-link"/> Consola Google</button>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
